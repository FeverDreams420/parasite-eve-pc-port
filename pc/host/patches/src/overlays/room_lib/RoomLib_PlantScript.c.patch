--- a/src/overlays/room_lib/RoomLib_PlantScript.c
+++ b/src/overlays/room_lib/RoomLib_PlantScript.c
@@ -3,7 +3,22 @@
  * field engine slot. The same function in every room that links it; the
  * program is the room's g_RoomScript (pe1/room_module.h).
  */
+/* Host: hide the header's no-argument declaration of RoomLib_PlantScript, which is
+ * redefined below to take the object (see the note there). */
+#define RoomLib_PlantScript RoomLib_PlantScript__host_hidden_decl
 #include "room_lib.h"
 #include "pe1/room_module.h"
+#undef RoomLib_PlantScript
 
+/* Host: the retail code calls FieldEng_GetSlot with a0 still holding this
+ * method's own argument, the object (Pm_AllocSlot calls the initialize
+ * method with the slot entry), and FieldEng_GetSlot(object) clears and sets
+ * up that object. The shared macro calls it with no argument, so on x86 it
+ * worked on a stack value. Redefined here to pass the object. */
+#undef ROOMLIB_PLANT_TABLE
+#define ROOMLIB_PLANT_TABLE(name, table) \
+    int name(void *o) { \
+        *((void **(*)(void *))FieldEng_GetSlot)(o) = table; \
+        return 0; \
+    }
 ROOMLIB_PLANT_TABLE(RoomLib_PlantScript, g_RoomScript)
