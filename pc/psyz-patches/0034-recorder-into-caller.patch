             SDL_ReleaseGPUTexture(device, rec.rgba);
@@ -3093,21 +3091,44 @@ int Psyz_VideoRecordStart(const char* path, int w, int h) {
     rec.row = realloc(rec.row, (size_t)w * h * 3);
     rec.present = 0;
     rec.t0 = SDL_GetPerformanceCounter();
+}
+
+int Psyz_VideoRecordStart(const char* path, int w, int h) {
+    if (rec.f || rec.sink || w <= 0 || h <= 0) {
+        return 0;
+    }
+    rec.f = fopen(path, "wb");
+    if (!rec.f) {
+        return 0;
+    }
+    RecSetSize(w, h);
+    return 1;
+}
+
+int Psyz_VideoRecordStartSink(Psyz_RecordSinkFn fn, int w, int h) {
+    if (rec.f || rec.sink || !fn || w <= 0 || h <= 0) {
+        return 0;
+    }
+    rec.sink = fn;
+    RecSetSize(w, h);
     return 1;
 }
 
 void Psyz_VideoRecordTag(unsigned frame) { rec.tag = frame; }
 
 void Psyz_VideoRecordStop(void) {
-    if (!rec.f) {
+    if (!rec.f && !rec.sink) {
         return;
     }
     SubmitFrame(); // anything still in the current command buffer
     for (int k = 0; k < REC_SLOTS; k++) {
         RecFlushSlot((rec.next + k) % REC_SLOTS, true);
     }
-    fclose(rec.f);
+    if (rec.f) {
+        fclose(rec.f);
+    }
     rec.f = NULL;
+    rec.sink = NULL;
 }
 
 
