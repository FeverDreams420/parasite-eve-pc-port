+ * @brief Debug recorder into the caller: as Psyz_VideoRecordStart, but each
+ * recorded present is handed to fn (present number, tag, ms since the start,
+ * w*h RGB, valid only during the call) instead of a file, so the caller can
+ * keep the last seconds in memory. Psyz_VideoRecordStop ends it.
+ */
+typedef void (*Psyz_RecordSinkFn)(unsigned present, unsigned tag, float t_ms, const unsigned char* rgb);
+int Psyz_VideoRecordStartSink(Psyz_RecordSinkFn fn, int w, int h);
