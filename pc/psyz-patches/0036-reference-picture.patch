+    const int ux1 = SDL_max(ref_drawn.x + ref_drawn.w, x1);
+    const int uy1 = SDL_max(ref_drawn.y + ref_drawn.h, y1);
+    ref_drawn = (SDL_Rect){ux0, uy0, ux1 - ux0, uy1 - uy0};
