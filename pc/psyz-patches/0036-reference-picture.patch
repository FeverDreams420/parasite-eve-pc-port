+            SDL_CopyGPUTextureToTexture(copy, &a, &c, (Uint32)w, 1, 1, false);
+        }
+    }
+    SDL_EndGPUCopyPass(copy);
+    RefNoteDrawn(dx, dy, w, h);
+}
