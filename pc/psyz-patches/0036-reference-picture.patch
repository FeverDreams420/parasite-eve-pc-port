+// a fill or upload: the same pixels of the 1x VRAM into the reference
+static void RefCopyFromVram(int x, int y, int w, int h) {
+    if (!ref_on || !vram_ref || w <= 0 || h <= 0) {
+        return;
+    }
+    SDL_GPUCommandBuffer* cmd = AcquireCmd();
+    if (!cmd) {
