+static void RefMove(int sx, int sy, int dx, int dy, int w, int h) {
+    if (!ref_on || !vram_ref || w <= 0 || h <= 0) {
+        return;
+    }
+    SDL_GPUCommandBuffer* cmd = AcquireCmd();
+    if (!cmd) {
+        return;
+    }
+    SDL_GPUCopyPass* copy = SDL_BeginGPUCopyPass(cmd);
+    if (!(sx < dx + w && dx < sx + w && sy < dy + h && dy < sy + h)) {
+        const SDL_GPUTextureLocation a = {.texture = vram_ref, .x = (Uint32)sx, .y = (Uint32)sy};
+        const SDL_GPUTextureLocation b = {.texture = ref_bounce, .x = (Uint32)sx, .y = (Uint32)sy};
+        const SDL_GPUTextureLocation c = {.texture = vram_ref, .x = (Uint32)dx, .y = (Uint32)dy};
+        SDL_CopyGPUTextureToTexture(copy, &a, &b, (Uint32)w, (Uint32)h, 1, false);
+        SDL_CopyGPUTextureToTexture(copy, &b, &c, (Uint32)w, (Uint32)h, 1, false);
+    } else {
+        for (int row = 0; row < h; row++) {
+            const SDL_GPUTextureLocation a = {
+                .texture = vram_ref, .x = (Uint32)sx, .y = (Uint32)(sy + row)};
