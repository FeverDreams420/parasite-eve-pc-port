+
+// One batch again into the reference picture (see vram_ref), at 1x, as the
+// PS1 draws it.
+static void RefDrawBatch(SDL_GPUCommandBuffer* cmd, float squeeze, float squeeze_centre,
+                         SDL_Rect clip) {
+    if (!vram_ref || !ref_vbuf || !ref_transfer || n_vertices <= 0) {
+        return;
+    }
+    Vertex* map = SDL_MapGPUTransferBuffer(device, ref_transfer, true);
+    if (!map) {
+        return;
+    }
+    for (int i = 0; i < n_vertices; i++) {
+        Vertex v = vertex_buf[i];
+        v.fx = 0;
+        v.fy = 0;
+        v.w = 0;
+        v.t &= (unsigned short)~TPAGE_SMOOTH;
+        map[i] = v;
+    }
+    SDL_UnmapGPUTransferBuffer(device, ref_transfer);
+    SDL_GPUCopyPass* copy = SDL_BeginGPUCopyPass(cmd);
+    const SDL_GPUTransferBufferLocation src = {.transfer_buffer = ref_transfer};
+    const SDL_GPUBufferRegion dst = {
+        .buffer = ref_vbuf, .size = (Uint32)(sizeof(Vertex) * n_vertices)};
+    SDL_UploadToGPUBuffer(copy, &src, &dst, true);
+    SDL_EndGPUCopyPass(copy);
+
+    const SDL_GPUColorTargetInfo target = {
+        .texture = vram_ref,
+        .load_op = SDL_GPU_LOADOP_LOAD,
+        .store_op = SDL_GPU_STOREOP_STORE,
+    };
+    SDL_GPURenderPass* pass = SDL_BeginGPURenderPass(cmd, &target, 1, NULL);
+    const float grid_scale_x = GetDrawGridXScale();
+    const SDL_GPUViewport viewport = {
+        .x = (float)draw_offset.x * (1.0f - grid_scale_x),
+        .y = 0.0f,
+        .w = (float)VRAM_W * grid_scale_x,
+        .h = (float)VRAM_H,
+        .min_depth = 0.0f,
+        .max_depth = 1.0f,
+    };
+    SDL_SetGPUViewport(pass, &viewport);
+    SDL_SetGPUScissor(pass, &clip);
+    const SDL_GPUBufferBinding vb = {.buffer = ref_vbuf};
+    SDL_BindGPUVertexBuffers(pass, 0, &vb, 1);
+    const SDL_GPUBufferBinding ib = {.buffer = ibuf};
+    SDL_BindGPUIndexBuffer(pass, &ib, SDL_GPU_INDEXELEMENTSIZE_16BIT);
+    SDL_GPUTextureSamplerBinding samplers[1 + PSYZ_HIRES_SLOTS] = {
+        {.texture = vram_sample, .sampler = vram_sampler}};
+    for (int i = 0; i < PSYZ_HIRES_SLOTS; i++) {
+        samplers[1 + i].texture = hires_dummy;
+        samplers[1 + i].sampler = vram_sampler;
+    }
+    SDL_BindGPUFragmentSamplers(pass, 0, samplers, 1 + PSYZ_HIRES_SLOTS);
+    const Sint32 hires_off[PSYZ_HIRES_SLOTS * 8] = {0};
+    SDL_PushGPUFragmentUniformData(cmd, 0, hires_off, sizeof(hires_off));
+    const float offset_ubo[8] = {(float)draw_offset.x, (float)draw_offset.y, squeeze,
+                                 squeeze_centre, 1.0f, 0.0f, 0.0f, 0.0f};
+    SDL_PushGPUVertexUniformData(cmd, 0, offset_ubo, sizeof(offset_ubo));
+    DrawBatchTriangles(pass);
+    SDL_EndGPURenderPass(pass);
+    RefNoteDrawn(clip.x, clip.y, clip.w, clip.h);
+}
+
+int Psyz_VideoRefBegin(void) {
+    if (!device || !vram_render) {
+        return -1;
+    }
+    if (ref_on) {
+        return 0;
+    }
+    Draw_FlushBuffer(); // what was queued before belongs to the frame before
+    if (!vram_ref) {
+        const SDL_GPUTextureCreateInfo info = {
+            .type = SDL_GPU_TEXTURETYPE_2D,
+            .format = SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM,
+            .usage = SDL_GPU_TEXTUREUSAGE_COLOR_TARGET | SDL_GPU_TEXTUREUSAGE_SAMPLER,
+            .width = VRAM_W,
+            .height = VRAM_H,
+            .layer_count_or_depth = 1,
+            .num_levels = 1,
+        };
+        vram_ref = SDL_CreateGPUTexture(device, &info);
+        ref_bounce = SDL_CreateGPUTexture(device, &info);
+        const SDL_GPUBufferCreateInfo binfo = {
+            .usage = SDL_GPU_BUFFERUSAGE_VERTEX,
+            .size = MAX_VERTEX_COUNT * sizeof(Vertex),
+        };
+        ref_vbuf = SDL_CreateGPUBuffer(device, &binfo);
+        const SDL_GPUTransferBufferCreateInfo tinfo = {
+            .usage = SDL_GPU_TRANSFERBUFFERUSAGE_UPLOAD,
+            .size = MAX_VERTEX_COUNT * sizeof(Vertex),
+        };
+        ref_transfer = SDL_CreateGPUTransferBuffer(device, &tinfo);
+        if (!vram_ref || !ref_bounce || !ref_vbuf || !ref_transfer) {
+            ERRORF("reference picture: %s", SDL_GetError());
+            return -1;
+        }
+    }
+    HdCatchUp();
+    SDL_GPUCommandBuffer* cmd = AcquireCmd();
+    if (!cmd) {
+        return -1;
+    }
+    // start from the VRAM as it is: the 1x VRAM, and what was drawn at HD
+    // and not yet copied down, copied down into the reference only
+    SDL_GPUCopyPass* copy = SDL_BeginGPUCopyPass(cmd);
+    const SDL_GPUTextureLocation src = {.texture = vram_render};
+    const SDL_GPUTextureLocation dst = {.texture = vram_ref};
+    SDL_CopyGPUTextureToTexture(copy, &src, &dst, VRAM_W, VRAM_H, 1, false);
+    SDL_EndGPUCopyPass(copy);
+    if (internal_res > 1 && scaled_vram_render && scaled_dirty.w > 0 && scaled_dirty.h > 0) {
+        const SDL_Rect r = scaled_dirty;
+        const SDL_GPUBlitInfo blit = {
+            .source = {.texture = scaled_vram_render,
+                       .x = (Uint32)(r.x * internal_res),
+                       .y = (Uint32)(r.y * internal_res),
+                       .w = (Uint32)(r.w * internal_res),
+                       .h = (Uint32)(r.h * internal_res)},
+            .destination = {.texture = vram_ref,
+                            .x = (Uint32)r.x,
+                            .y = (Uint32)r.y,
+                            .w = (Uint32)r.w,
+                            .h = (Uint32)r.h},
+            .load_op = SDL_GPU_LOADOP_LOAD,
+            .filter = SDL_GPU_FILTER_NEAREST,
+        };
+        SDL_BlitGPUTexture(cmd, &blit);
+    }
+    ref_drawn = (SDL_Rect){0, 0, 0, 0};
+    ref_on = true;
+    return 0;
+}
+
+void Psyz_VideoRefEnd(void) {
+    Draw_FlushBuffer();
+    ref_on = false;
+}
+
+unsigned char* Psyz_VideoRefCapture(int* w, int* h, float* coverage) {
+    if (!ref_on || !vram_ref || disp_rgb24) {
+        return NULL;
+    }
+    Draw_FlushBuffer();
+    int x = display_area.x, y = display_area.y;
+    int dw = display_size.x, dh = display_size.y;
+    if (x + dw > VRAM_W) {
+        dw = VRAM_W - x;
+    }
+    if (y + dh > VRAM_H) {
+        dh = VRAM_H - y;
+    }
+    if (dw <= 0 || dh <= 0) {
+        return NULL;
+    }
+    u8* rgba = malloc((size_t)dw * dh * 4);
+    unsigned char* out = calloc((size_t)dw * dh, 3);
+    if (!rgba || !out || !VchkDownload(vram_ref, x, y, dw, dh, rgba)) {
+        free(rgba);
+        free(out);
+        return NULL;
+    }
+    int top, lines;
+    VisibleRows(&top, &lines);
+    for (int row = top; row < top + lines && row < dh; row++) {
+        const u8* s = rgba + (size_t)(row - top) * dw * 4;
+        unsigned char* d = out + (size_t)row * dw * 3;
+        for (int i = 0; i < dw; i++, s += 4, d += 3) {
+            d[0] = s[0];
+            d[1] = s[1];
+            d[2] = s[2];
+        }
+    }
+    free(rgba);
+    if (coverage) {
+        const int ix0 = SDL_max(x, ref_drawn.x), iy0 = SDL_max(y, ref_drawn.y);
+        const int ix1 = SDL_min(x + dw, ref_drawn.x + ref_drawn.w);
+        const int iy1 = SDL_min(y + dh, ref_drawn.y + ref_drawn.h);
+        *coverage = (ix1 > ix0 && iy1 > iy0) ? (float)(ix1 - ix0) * (float)(iy1 - iy0) /
+                                                   ((float)dw * (float)dh)
+                                             : 0.0f;
+    }
+    *w = dw;
+    *h = dh;
+    return out;
+}
