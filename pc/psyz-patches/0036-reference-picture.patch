+    SDL_GPUCopyPass* copy = SDL_BeginGPUCopyPass(cmd);
+    const SDL_GPUTextureLocation src = {.texture = vram_render, .x = (Uint32)x, .y = (Uint32)y};
+    const SDL_GPUTextureLocation dst = {.texture = vram_ref, .x = (Uint32)x, .y = (Uint32)y};
+    SDL_CopyGPUTextureToTexture(copy, &src, &dst, (Uint32)w, (Uint32)h, 1, false);
+    SDL_EndGPUCopyPass(copy);
+    RefNoteDrawn(x, y, w, h);
+}
+// MoveImage inside the reference (its own pixels, which may differ from the
