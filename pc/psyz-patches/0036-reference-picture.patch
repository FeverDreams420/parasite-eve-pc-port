+    zassert_ptr_ne(NULL, at1x);
+    zassert_s32_eq(0, Psyz_VideoSetInternalResolution(2));
+    {
+        // so a reference that drew nothing cannot match
+        RECT all = {0, 0, 640, 480};
+        ClearImage(&all, 0, 0, 0);
+        DrawSync(0);
+    }
+    zassert_s32_eq(0, Psyz_VideoRefBegin());
+    RefScene(tpage, clut);
+    unsigned char* ref = Psyz_VideoRefCapture(&w2, &h2, &cover);
+    Psyz_VideoRefEnd();
+    zassert_ptr_ne(NULL, ref);
+    zexpect_s32_eq(w1, w2);
+    zexpect_s32_eq(h1, h2);
+    zexpect_s32_eq(100, (int)(cover * 100.0f + 0.5f));
+    zexpect_u8array_eq(at1x, ref, (size_t)w1 * h1 * 3);
+    free(at1x);
+    free(ref);
+    zassert_ptr_eq(NULL, Psyz_VideoRefCapture(&w2, &h2, &cover)); // ended
+    zassert_s32_eq(0, Psyz_VideoSetInternalResolution(1));
+}
 #endif
