+static void RefNoteDrawn(int x, int y, int w, int h) {
+    const int x0 = CLAMP(x, 0, VRAM_W), y0 = CLAMP(y, 0, VRAM_H);
+    const int x1 = CLAMP(x + w, 0, VRAM_W), y1 = CLAMP(y + h, 0, VRAM_H);
+    if (x1 <= x0 || y1 <= y0) {
