+static int pgxp_try(int f, double x, double y, double z, int sx, int sy) {
+    double r[3][3], t[3], lo = f ? 4.0 : 1.0;
+    int i, j;
+    for (i = 0; i < 3; i++) {
+        for (j = 0; j < 3; j++) {
+            r[i][j] = f ? pgxp_fm_r[i][j] : (double)M.m[i][j];
+        }
+        t[i] = f ? pgxp_fm_t[i] : (double)M.t[i];
+    }
+    double pz = t[2] + (r[2][0] * x + r[2][1] * y + r[2][2] * z) / 4096.0;
+    if (pz < 1.0) {
+        return 0;
+    }
+    double px = t[0] + (r[0][0] * x + r[0][1] * y + r[0][2] * z) / 4096.0;
+    double py = t[1] + (r[1][0] * x + r[1][1] * y + r[1][2] * z) / 4096.0;
+    double psx = OFX + (double)H * px / pz;
+    double psy = OFY + (double)H * py / pz;
+    // full precision moves a vertex a few pixels at most
+    if (psx > sx - lo && psx < sx + 1.0 + lo && psy > sy - lo && psy < sy + 1.0 + lo) {
+        pgxp_record(sx, sy, psx, psy);
+        return 1;
+    }
+    return 0;
+}
