+// A matrix given at full precision for the next projections
+// (Psyz_PgxpSetFloatMatrix): used while the GTE still holds the integer
+// matrix it was given with, so another matrix loaded later is never mixed up
+// with it.
+static int pgxp_fm_on;
+static MATRIX pgxp_fm_int;
+static double pgxp_fm_r[3][3], pgxp_fm_t[3];
+
+void Psyz_PgxpSetFloatMatrix(const float r[9], const float t[3]) {
+    int i, j;
+    pgxp_fm_on = 1;
+    pgxp_fm_int = M;
+    for (i = 0; i < 3; i++) {
+        for (j = 0; j < 3; j++) {
+            pgxp_fm_r[i][j] = r[i * 3 + j];
+        }
+        pgxp_fm_t[i] = t[i];
+    }
+}
+
+void Psyz_PgxpClearFloatMatrix(void) { pgxp_fm_on = 0; }
+
+static inline int pgxp_fm_current(void) {
+    return pgxp_fm_on && !memcmp(&pgxp_fm_int, &M, sizeof(MATRIX));
+}
