+/**
+ * @brief Capture the displayed frame at the internal resolution
+ *
+ * Like Psyz_VideoAllocCapturedFrame, but read from the scaled render target,
+ * so the size is the display size times the internal resolution. At 1x, and
+ * for 24-bit (movie) display, it is the same as Psyz_VideoAllocCapturedFrame.
+ *
+ * @param w Output frame width
+ * @param h Output frame height
+ * @return NULL on failure, or RGB888 buffer to be destroyed with free(ptr)
+ */
+unsigned char* Psyz_VideoAllocCapturedFrameScaled(int* w, int* h);
+
 /**
