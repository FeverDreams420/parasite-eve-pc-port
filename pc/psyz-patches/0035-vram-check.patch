+// For the VRAM check (Psyz_VideoVramCheck): 1 where the GPU's VRAM should
+// hold exactly what vram_shadow says, because only uploads, fills and copies
+// have written there since; drawing sets its scissor rectangle back to 0.
+// known_drawn is the last rectangle cleared, so repeated batches into the
+// same drawing area cost nothing.
+static u8 vram_known[VRAM_H][VRAM_W];
+static SDL_Rect known_drawn = {0, 0, 0, 0};
+static void KnownSet(int x, int y, int w, int h, u8 v) {
+    const int x0 = CLAMP(x, 0, VRAM_W), y0 = CLAMP(y, 0, VRAM_H);
+    const int x1 = CLAMP(x + w, 0, VRAM_W), y1 = CLAMP(y + h, 0, VRAM_H);
+    for (int j = y0; j < y1 && x1 > x0; j++) {
+        memset(&vram_known[j][x0], v, (size_t)(x1 - x0));
+    }
+    known_drawn = (SDL_Rect){0, 0, 0, 0};
+}
+static void KnownDrawn(SDL_Rect r) {
+    if (r.w <= 0 || r.h <= 0 || (r.x == known_drawn.x && r.y == known_drawn.y &&
+                                 r.w == known_drawn.w && r.h == known_drawn.h)) {
+        return;
+    }
+    KnownSet(r.x, r.y, r.w, r.h, 0);
+    known_drawn = r;
+}
