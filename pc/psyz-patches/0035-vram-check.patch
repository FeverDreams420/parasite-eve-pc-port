+#ifndef __psx__
+#ifndef __PSP__
+// Psyz_VideoVramCheck: uploads, fills and copies outside the drawing area
+// read back as written at 1x and 2x; the drawn area is not checked.
+static void VramCheckScene(void) {
+    u_short tpage, clut;
+    u_short pattern[32 * 16];
+    RECT up = {640, 256, 32, 16};
+    RECT fill = {704, 256, 16, 16};
+    RECT mv = {640, 256, 16, 16};
+    if (LoadTim(img_4bpp, &tpage, &clut)) {
+        return;
+    }
+    for (int i = 0; i < 32 * 16; i++) {
+        pattern[i] = (u_short)(i * 0x1235);
+    }
+    LoadImage(&up, (u_long*)pattern);
+    ClearImage(&fill, 200, 100, 50);
+    MoveImage(&mv, 640, 300);
+    SetPolyFT4(&cdb->ft4[0]);
+    setXYWH(&cdb->ft4[0], 16, 16, 64, 64);
+    setRGB0(&cdb->ft4[0], 128, 128, 128);
+    setUVWH(&cdb->ft4[0], 0, 0, 64, 64);
+    setSemiTrans(&cdb->ft4[0], 0);
+    cdb->ft4[0].tpage = tpage;
+    cdb->ft4[0].clut = clut;
+    ClearOTag(cdb->ot, OTSIZE);
+    AddPrim(cdb->ot, &db[0].ft4[0]);
+    DrawOTag(cdb->ot);
+    DrawSync(0);
+    VSync(0);
+}
+
+static void ExpectVramCheckClean(int full) {
+    Psyz_VramCheck c;
+    zassert_s32_eq(0, Psyz_VideoVramCheck(&c, full));
+    zexpect_u32_eq(0, c.n_native);
+    zexpect_u32_eq(0, c.n_sample);
+    zexpect_u32_eq(0, c.n_hd);
+    zexpect_u32_gt(0, c.n_known);
+    // the upload, the fill and the copy are checked; the drawn picture is not
+    zexpect_u32_eq(PSYZ_VCHK_KNOWN, c.status[256 * 1024 + 640] & PSYZ_VCHK_KNOWN);
+    zexpect_u32_eq(PSYZ_VCHK_KNOWN, c.status[260 * 1024 + 710] & PSYZ_VCHK_KNOWN);
+    zexpect_u32_eq(PSYZ_VCHK_KNOWN, c.status[300 * 1024 + 640] & PSYZ_VCHK_KNOWN);
+    zexpect_u32_eq(0, c.status[32 * 1024 + 32] & PSYZ_VCHK_KNOWN);
+    Psyz_VideoVramCheckFree(&c);
+}
+
+ZTEST(gpu, vram_check) {
+    zskip_targets("psp;ps1");
+    VramCheckScene();
+    ExpectVramCheckClean(0);
+    zassert_s32_eq(0, Psyz_VideoSetInternalResolution(2));
+    VramCheckScene();
+    ExpectVramCheckClean(0);
+    ExpectVramCheckClean(1);
+    zassert_s32_eq(0, Psyz_VideoSetInternalResolution(1));
+}
