+
+// VRAM check (debug, Psyz_VideoVramCheck). Reads back the 1x VRAM, the 1x
+// copy that polygons sample (vram_sample) and the HD VRAM, and compares each
+// with vram_shadow wherever vram_known says nothing has drawn since the last
+// upload, fill or copy. Every read waits for the GPU.
+static bool VchkDownload(SDL_GPUTexture* tex, int x, int y, int w, int h, u8* out) {
+    const SDL_GPUTransferBufferCreateInfo info = {
+        .usage = SDL_GPU_TRANSFERBUFFERUSAGE_DOWNLOAD,
+        .size = (Uint32)((size_t)w * h * 4),
+    };
+    SDL_GPUTransferBuffer* tb = SDL_CreateGPUTransferBuffer(device, &info);
+    SDL_GPUCommandBuffer* cmd = tb ? AcquireCmd() : NULL;
+    if (!cmd) {
+        if (tb) {
+            SDL_ReleaseGPUTransferBuffer(device, tb);
+        }
+        return false;
+    }
+    SDL_GPUCopyPass* copy = SDL_BeginGPUCopyPass(cmd);
+    const SDL_GPUTextureRegion region = {
+        .texture = tex, .x = (Uint32)x, .y = (Uint32)y, .w = (Uint32)w, .h = (Uint32)h, .d = 1};
+    const SDL_GPUTextureTransferInfo transfer = {.transfer_buffer = tb};
+    SDL_DownloadFromGPUTexture(copy, &region, &transfer);
+    SDL_EndGPUCopyPass(copy);
+    SubmitCmdAndWait();
+    const u8* map = SDL_MapGPUTransferBuffer(device, tb, false);
+    if (map) {
+        memcpy(out, map, (size_t)w * h * 4);
+        SDL_UnmapGPUTransferBuffer(device, tb);
+    }
+    SDL_ReleaseGPUTransferBuffer(device, tb);
+    return map != NULL;
+}
+
+static bool InRect(SDL_Rect r, int x, int y) {
+    return r.w > 0 && r.h > 0 && x >= r.x && x < r.x + r.w && y >= r.y && y < r.y + r.h;
+}
+
+int Psyz_VideoVramCheck(Psyz_VramCheck* out, int full) {
+    memset(out, 0, sizeof(*out));
+    if (!device || !vram_render || !vram_sample) {
+        return -1;
+    }
+    Draw_FlushBuffer(); // queued drawing first (it marks its area as drawn)
+    const size_t px = (size_t)VRAM_W * VRAM_H;
+    const int n = (internal_res > 1 && scaled_vram_render) ? (int)internal_res : 1;
+    out->status = calloc(px, 1);
+    out->native = malloc(px * 2);
+    out->sample = malloc(px * 2);
+    out->hd = n > 1 ? malloc(px * 2) : NULL;
+    u8* rgba = malloc(px * 4);
+    if (!out->status || !out->native || !out->sample || (n > 1 && !out->hd) || !rgba) {
+        free(rgba);
+        Psyz_VideoVramCheckFree(out);
+        return -1;
+    }
+    out->scale = n;
+    out->full = full && n > 1;
+    const SDL_Rect sample_pending = vram_dirty; // copied to vram_sample by the next textured batch
+    const SDL_Rect hd_wait = hd_pending;        // uploads not yet copied up (movie)
+    bool ok = VchkDownload(vram_render, 0, 0, VRAM_W, VRAM_H, rgba);
+    if (ok) {
+        ConvertRgba8888ToRgb5551(rgba, out->native, px);
+        ok = VchkDownload(vram_sample, 0, 0, VRAM_W, VRAM_H, rgba);
+    }
+    if (ok) {
+        ConvertRgba8888ToRgb5551(rgba, out->sample, px);
+    }
+    for (int y = 0; ok && y < VRAM_H; y++) {
+        for (int x = 0; x < VRAM_W; x++) {
+            const size_t i = (size_t)y * VRAM_W + x;
+            if (!vram_known[y][x]) {
+                continue;
+            }
+            const u16 want = vram_shadow[y][x];
+            u8 st = PSYZ_VCHK_KNOWN;
+            out->n_known++;
+            if (out->native[i] != want) {
+                st |= PSYZ_VCHK_NATIVE;
+                out->n_native++;
+            }
+            if (!InRect(sample_pending, x, y) && out->sample[i] != want) {
+                st |= PSYZ_VCHK_SAMPLE;
+                out->n_sample++;
+            }
+            if (n > 1 && InRect(hd_wait, x, y)) {
+                st |= PSYZ_VCHK_SKIP_HD;
+                out->n_skip_hd++;
+            }
+            out->status[i] = st;
+        }
+    }
+    if (ok && n > 1 && !out->full) {
+        // one texel per pixel, picked by the same nearest blit that copies a
+        // drawn area down (SyncScaledVramToNative)
+        static SDL_GPUTexture* vchk_small;
+        if (!vchk_small) {
+            const SDL_GPUTextureCreateInfo info = {
+                .type = SDL_GPU_TEXTURETYPE_2D,
+                .format = SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM,
+                .usage = SDL_GPU_TEXTUREUSAGE_COLOR_TARGET | SDL_GPU_TEXTUREUSAGE_SAMPLER,
+                .width = VRAM_W,
+                .height = VRAM_H,
+                .layer_count_or_depth = 1,
+                .num_levels = 1,
+            };
+            vchk_small = SDL_CreateGPUTexture(device, &info);
+        }
+        SDL_GPUCommandBuffer* cmd = vchk_small ? AcquireCmd() : NULL;
+        ok = cmd != NULL;
+        if (ok) {
+            const SDL_GPUBlitInfo blit = {
+                .source = {.texture = scaled_vram_render,
+                           .w = (Uint32)(VRAM_W * n),
+                           .h = (Uint32)(VRAM_H * n)},
+                .destination = {.texture = vchk_small, .w = VRAM_W, .h = VRAM_H},
+                .load_op = SDL_GPU_LOADOP_DONT_CARE,
+                .filter = SDL_GPU_FILTER_NEAREST,
+            };
+            SDL_BlitGPUTexture(cmd, &blit);
+            ok = VchkDownload(vchk_small, 0, 0, VRAM_W, VRAM_H, rgba);
+        }
+        if (ok) {
+            ConvertRgba8888ToRgb5551(rgba, out->hd, px);
+            for (size_t i = 0; i < px; i++) {
+                const u8 st = out->status[i];
+                if ((st & PSYZ_VCHK_KNOWN) && !(st & PSYZ_VCHK_SKIP_HD) &&
+                    out->hd[i] != ((const u16*)vram_shadow)[i]) {
+                    out->status[i] |= PSYZ_VCHK_HD;
+                    out->n_hd++;
+                }
+            }
+        }
+    } else if (ok && n > 1) {
+        // every HD texel: each pixel's n x n block must all be the shadow's
+        // colour. Read in strips of 16 VRAM rows (4 MiB at 8x).
+        const int rows = 16, sw = VRAM_W * n;
+        u8* strip = malloc((size_t)sw * rows * n * 4);
+        ok = strip != NULL;
+        for (int y0 = 0; ok && y0 < VRAM_H; y0 += rows) {
+            ok = VchkDownload(scaled_vram_render, 0, y0 * n, sw, rows * n, strip);
+            for (int y = y0; ok && y < y0 + rows; y++) {
+                for (int x = 0; x < VRAM_W; x++) {
+                    const size_t i = (size_t)y * VRAM_W + x;
+                    const u16 want = vram_shadow[y][x];
+                    const u8* mid = strip + (((size_t)(y - y0) * n + n / 2) * sw + (size_t)x * n + n / 2) * 4;
+                    u16 got;
+                    ConvertRgba8888ToRgb5551(mid, &got, 1);
+                    out->hd[i] = got;
+                    const u8 st = out->status[i];
+                    if (!(st & PSYZ_VCHK_KNOWN) || (st & PSYZ_VCHK_SKIP_HD)) {
+                        continue;
+                    }
+                    int bad = 0;
+                    for (int ty = 0; ty < n; ty++) {
+                        const u8* t = strip + (((size_t)(y - y0) * n + ty) * sw + (size_t)x * n) * 4;
+                        for (int tx = 0; tx < n; tx++, t += 4) {
+                            u16 v;
+                            ConvertRgba8888ToRgb5551(t, &v, 1);
+                            if (v != want) {
+                                if (!bad) {
+                                    out->hd[i] = v; // the first texel that differs
+                                }
+                                bad++;
+                            }
+                        }
+                    }
+                    if (bad) {
+                        out->status[i] |= PSYZ_VCHK_HD;
+                        out->n_hd++;
+                        out->n_hd_texels += (unsigned)bad;
+                    }
+                }
+            }
+        }
+        free(strip);
+    }
+    free(rgba);
+    if (!ok) {
+        Psyz_VideoVramCheckFree(out);
+        return -1;
+    }
+    out->sample_pending[0] = sample_pending.x;
+    out->sample_pending[1] = sample_pending.y;
+    out->sample_pending[2] = sample_pending.w;
+    out->sample_pending[3] = sample_pending.h;
+    out->hd_pending[0] = hd_wait.x;
+    out->hd_pending[1] = hd_wait.y;
+    out->hd_pending[2] = hd_wait.w;
+    out->hd_pending[3] = hd_wait.h;
+    return 0;
+}
+
+void Psyz_VideoVramCheckFree(Psyz_VramCheck* c) {
+    free(c->status);
+    free(c->native);
+    free(c->sample);
+    free(c->hd);
+    c->status = NULL;
+    c->native = c->sample = c->hd = NULL;
+}
