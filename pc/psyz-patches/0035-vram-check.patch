 const unsigned short* Psyz_VramShadow(void);
 
+/**
+ * @brief Debug VRAM check. Compares the GPU's VRAM with Psyz_VramShadow
+ * wherever only uploads, fills and copies have written since (drawing marks
+ * its scissor rectangle as not known): the 1x VRAM, the 1x copy polygons
+ * sample, and above 1x the HD VRAM, either one texel per pixel as a drawn
+ * area is copied down (full = 0) or every texel (full = 1, reads the whole
+ * HD VRAM). Waits for the GPU. Returns 0, or -1 if it could not read.
+ * Free the result with Psyz_VideoVramCheckFree.
+ */
+#define PSYZ_VCHK_KNOWN 1   /* checked: nothing drawn here since it was written */
+#define PSYZ_VCHK_NATIVE 2  /* 1x VRAM differs */
+#define PSYZ_VCHK_SAMPLE 4  /* 1x copy that polygons sample differs */
+#define PSYZ_VCHK_HD 8      /* HD VRAM differs */
+#define PSYZ_VCHK_SKIP_HD 16 /* upload not yet copied up to HD (movie): HD not checked */
+typedef struct {
+    unsigned char* status;  /* 1024 x 512, PSYZ_VCHK_* bits */
+    unsigned short* native; /* 1x VRAM, 15-bit colour + mask bit */
+    unsigned short* sample; /* 1x copy that polygons sample */
+    unsigned short* hd;     /* HD VRAM per pixel (centre texel, or the first
+                               texel that differs); NULL at 1x */
+    int scale;              /* internal resolution */
+    int full;               /* every HD texel was compared */
+    unsigned n_known, n_native, n_sample, n_hd, n_hd_texels, n_skip_hd;
+    int sample_pending[4];  /* x, y, w, h not yet copied to the sampled copy */
+    int hd_pending[4];      /* x, y, w, h not yet copied up to HD */
+} Psyz_VramCheck;
+int Psyz_VideoVramCheck(Psyz_VramCheck* out, int full);
+void Psyz_VideoVramCheckFree(Psyz_VramCheck* c);
+
 /** @brief Debug: the next present is also saved (1920x1080 PPM) to path. */
 void Psyz_VideoPresentTestNext(const char* path);
 
