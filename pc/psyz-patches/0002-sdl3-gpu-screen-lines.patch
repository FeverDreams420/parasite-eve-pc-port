+// The captured frame is the whole screen as shown: rows outside the
+// visible lines are black and the picture starts screen_top rows down.
+unsigned char* Psyz_VideoAllocCapturedFrame(int* w, int* h) {
+    unsigned char* rows = AllocDisplayRows(w, h);
+    int top, lines;
+    if (!rows) {
+        return NULL;
+    }
+    VisibleRows(&top, &lines);
+    if (lines < *h) {
+        size_t stride = (size_t)*w * 3;
+        unsigned char* out = calloc((size_t)*h, stride);
+        if (!out) {
+            return rows;
+        }
+        memcpy(out + (size_t)top * stride, rows, (size_t)lines * stride);
+        free(rows);
+        return out;
+    }
+    return rows;
+}
