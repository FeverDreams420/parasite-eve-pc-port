+// Lines of the 240-line (NTSC) screen that show the display area, from
+// DISPENV.screen: the picture starts screen_top lines down and is
+// screen_lines tall (0 = the whole screen); the rest is black, as on a TV.
+static int screen_top = 0;
+static int screen_lines = 0;
+void Psyz_VideoSetScreenLines(int top, int lines) {
+    screen_top = top < 0 ? 0 : top;
+    screen_lines = lines < 0 ? 0 : lines;
+}
+// Visible part of the display, in display_size rows.
+static void VisibleRows(int* first, int* count) {
+    int scale = display_size.y > 240 ? 2 : 1;
+    int top = screen_top * scale;
+    int lines = screen_lines ? screen_lines * scale : display_size.y;
+    if (top >= display_size.y) {
+        top = 0;
+    }
+    if (top + lines > display_size.y) {
+        lines = display_size.y - top;
+    }
+    *first = top;
+    *count = lines;
+}
