                 if (debug_show_vram) {
                     src.x = 0;
                     src.y = 0;
@@ -931,6 +1033,13 @@ static unsigned char* AllocRgb888Region(int x, int y, int w, int h) {
 unsigned char* Psyz_VideoAllocCapturedFrame(int* w, int* h) {
     *w = display_size.x;
     *h = display_size.y;
