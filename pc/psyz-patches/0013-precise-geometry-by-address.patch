diff --git a/psyz/include/psyz/video.h b/psyz/include/psyz/video.h
index 7c6a474..5a150f9 100644
--- a/psyz/include/psyz/video.h
+++ b/psyz/include/psyz/video.h
@@ -324,6 +324,21 @@ void Psyz_VideoSetPrecision(int on);
 void Psyz_PgxpSetFloatMatrix(const float r[9], const float t[3]);
 void Psyz_PgxpClearFloatMatrix(void);
 
+/**
+ * @brief Exact positions by where the game keeps a vertex
+ *
+ * Psyz_PgxpLast gives the exact position of screen XY register k (0 to 2,
+ * as RTPT leaves them) of the last projection, if sxy is what the GTE gave
+ * there. Psyz_PgxpTag ties an exact position to the memory word where the
+ * game stored that vertex's screen XY inside a polygon; a polygon read from
+ * there gets it, even when another vertex rounded to the same pixel.
+ */
+int Psyz_PgxpLast(int k, unsigned int sxy, float* x, float* y);
+void Psyz_PgxpTag(const void* addr, unsigned int sxy, float x, float y);
+/** Psyz_GpuWriteGP0, saying where in memory the word was read from, so a
+ * polygon's vertices can be matched with their Psyz_PgxpTag. */
+void Psyz_GpuWriteGP0At(unsigned int word, const void* from);
+
 void Psyz_VideoSetWidescreen(int on);
 int Psyz_VideoGetWidescreen(void);
 
