+                    const void* src = xy_at[k] ? Psyz_GpuWordSource(xy_at[k]) : NULL;
+                    if (src ? Psyz_PgxpLookupAt(src, (unsigned)*xy_at[k], &px, &py)
+                            : Psyz_PgxpLookup(sxy, &px, &py)) {
                         pgxp_stat_hit++;
                         float dx = px - (float)pv->x - 0.5f;
                         float dy = py - (float)pv->y - 0.5f;
-                        dx = dx < -0.5f ? -0.5f : (dx > 0.5f ? 0.5f : dx);
-                        dy = dy < -0.5f ? -0.5f : (dy > 0.5f ? 0.5f : dy);
-                        pv->fx = (signed char)(dx * 254.0f);
-                        pv->fy = (signed char)(dy * 254.0f);
+                        dx = dx < -2.0f ? -2.0f : (dx > 2.0f ? 2.0f : dx);
+                        dy = dy < -2.0f ? -2.0f : (dy > 2.0f ? 2.0f : dy);
+                        pv->fx = (signed char)(dx * 63.5f);
+                        pv->fy = (signed char)(dy * 63.5f);
                     }
                 }
             }
