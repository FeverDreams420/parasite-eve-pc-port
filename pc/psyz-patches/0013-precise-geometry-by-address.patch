+            xy_at[0] = packets;
             wr = writePacket(v++, code, len, packets, &clut);
             packets += wr;
             len -= wr;
+            xy_at[1] = packets;
             wr = writePacket(v++, code, len, packets, &tpage);
             packets += wr;
             len -= wr;
+            xy_at[2] = packets;
             wr = writePacket(v++, code, len, packets, &pad2);
             packets += wr;
             len -= wr;
