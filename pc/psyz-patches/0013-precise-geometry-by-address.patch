             index_cur[1] = n_vertices + 1;
@@ -1518,22 +1523,26 @@ int Draw_PushPrim(u_long* packets, int max_len) {
                 vertex_cur[3].uvlim = uvlim;
             if (Psyz_PgxpEnabled()) {
                 // precise geometry: vertices the GTE projected get their
-                // exact position (centred on the pixel the GTE rounded to)
+                // exact position, up to 2 pixels from the one the GTE gave
+                // (found by where the polygon keeps the vertex, if the port
