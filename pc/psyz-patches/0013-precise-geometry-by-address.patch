+// Exact positions tagged by where a polygon's vertex sits in memory
+// (Psyz_PgxpTag): two vertices that round to the same pixel can't be mixed
+// up there.
+#define PGXP_TAGS 16384
+#define PGXP_TAG_PROBE 8
+static struct {
+    const void* addr;
+    unsigned sxy, gen;
+    float x, y;
+} pgxp_tag[PGXP_TAGS];
+
+static inline unsigned pgxp_tag_hash(const void* a) {
+    return pgxp_hash((unsigned)(size_t)a >> 2);
+}
+
+void Psyz_PgxpTag(const void* addr, unsigned int sxy, float x, float y) {
+    unsigned h, i, slot;
+    if (!pgxp_on) {
+        return;
+    }
+    h = slot = pgxp_tag_hash(addr) & (PGXP_TAGS - 1);
+    for (i = 0; i < PGXP_TAG_PROBE; i++) {
+        unsigned j = (h + i) & (PGXP_TAGS - 1);
+        if (pgxp_tag[j].addr == addr || pgxp_tag[j].gen + 1 < pgxp_gen) {
+            slot = j;
+            break;
+        }
+    }
+    pgxp_tag[slot].addr = addr;
+    pgxp_tag[slot].sxy = sxy;
+    pgxp_tag[slot].gen = pgxp_gen;
+    pgxp_tag[slot].x = x;
+    pgxp_tag[slot].y = y;
+}
+
+int Psyz_PgxpLookupAt(const void* addr, unsigned int sxy, float* x, float* y) {
+    unsigned h, i;
+    if (!pgxp_on) {
+        return 0;
+    }
+    if (getenv("PE_LOG_PA3")) {
+        static int n;
+        if (n++ < 6) {
+            INFOF("lookup at %p sxy %08x", addr, sxy);
+        }
+    }
+    h = pgxp_tag_hash(addr) & (PGXP_TAGS - 1);
+    for (i = 0; i < PGXP_TAG_PROBE; i++) {
+        unsigned j = (h + i) & (PGXP_TAGS - 1);
+        if (pgxp_tag[j].addr == addr) {
+            if (pgxp_tag[j].sxy == sxy && pgxp_tag[j].gen + 1 >= pgxp_gen) {
+                pgxp_tag_hits++;
+                *x = pgxp_tag[j].x;
+                *y = pgxp_tag[j].y;
+                return 1;
+            }
+            break;
+        }
+    }
+    return Psyz_PgxpLookup(sxy, x, y);
+}
