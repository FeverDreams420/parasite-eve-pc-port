 // optimization to avoid sampling the VRAM on an untextured batch draw
 static bool batch_has_texture = false;
+// VRAM areas the textured primitives of this batch read (texture pages and
+// CLUTs, 1x VRAM pixels), so a batch that does not read a drawn area needs
+// no copy of it (SyncScaledVramToNative)
+#define BATCH_SAMPLES 16
+static SDL_Rect batch_sample[BATCH_SAMPLES];
+static int batch_samples;
+static bool batch_sample_all;
+static void NoteBatchSample(int x, int y, int w, int h) {
+    for (int i = 0; i < batch_samples; i++) {
+        if (batch_sample[i].x == x && batch_sample[i].y == y && batch_sample[i].w == w &&
+            batch_sample[i].h == h) {
+            return;
+        }
+    }
+    if (batch_samples == BATCH_SAMPLES) {
+        batch_sample_all = true;
+        return;
+    }
+    batch_sample[batch_samples++] = (SDL_Rect){x, y, w, h};
+}
+static void NoteSampledBy(const Vertex* v) {
+    unsigned t = v->t, depth = (t >> 7) & 3;
+    if (t & TPAGE_NOTEXTURE) {
+        return;
+    }
+    NoteBatchSample((int)(t & 15) * 64, (int)((t >> 4) & 1) * 256,
+                    depth == 0 ? 64 : (depth == 1 ? 128 : 256), 256);
+    if (depth < 2) {
+        NoteBatchSample((int)(v->c & 63) * 16, (int)((v->c >> 6) & 511), depth == 0 ? 16 : 256, 1);
+    }
+}
+static bool BatchSamplesScaledDirty(void) {
+    if (batch_sample_all) {
+        return true;
+    }
+    for (int i = 0; i < batch_samples; i++) {
+        if (ScaledDirtyOverlaps(batch_sample[i].x, batch_sample[i].y, batch_sample[i].w,
+                                batch_sample[i].h)) {
+            return true;
+        }
+    }
+    return false;
+}
