+// One refresh step under clock pacing: show the frame unless it is a repeat
+// (Psyz_VideoSkipNextPresent) or, in fast forward, a refresh has not passed
+// since the last one shown; then wait for the schedule (one refresh per step;
+// more than 50 ms late, it starts again from now).
+static void ClockPacedStep(void) {
+    const Uint64 step = (Uint64)((double)perf_frequency / display_hz);
+    const bool limitless = vsync_mode == PSYZ_VSYNC_LIMITLESS;
+    Uint64 now = SDL_GetPerformanceCounter();
+    bool show = !skip_next_present;
+    skip_next_present = false;
+    if (show && limitless && last_present_pc && now - last_present_pc < step - step / 20) {
+        show = false;
+    }
+    if (show) {
+        PlatformBackend_Present();
+        last_present_pc = SDL_GetPerformanceCounter();
+    } else {
+        finish_time = now;
+    }
+    PollEvents();
+    now = SDL_GetPerformanceCounter();
+    if (limitless) {
+        clock_due = 0;
+    } else if (!clock_due || now > clock_due + perf_frequency / 20) {
+        clock_due = now;
+    } else {
+        clock_due += step;
+        if (now < clock_due) {
+            SDL_DelayPrecise((Uint64)((double)(clock_due - now) * 1e9 / (double)perf_frequency));
+        }
+    }
+    now = SDL_GetPerformanceCounter();
+    gpu_stats.last_frame_time_us = GetElapsedMicroseconds(last_frame_time, now);
+    gpu_stats.last_draw_time_us = GetElapsedMicroseconds(last_frame_time, finish_time);
+    gpu_stats.target_frame_time_us = 1000000.0 / display_hz;
+    gpu_stats.total_frames++;
+    gpu_stats.using_driver_vsync = false;
+    last_frame_time = now;
+}
