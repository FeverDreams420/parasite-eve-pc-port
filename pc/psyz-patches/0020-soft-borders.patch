+// The soft-border pipeline, made at first use for the window's format.
+static bool EnsureBorderPipeline(void) {
+    if (pipe_border || border_failed) {
+        return pipe_border != NULL;
+    }
+    border_failed = true;
+    SDL_GPUShader* vs =
+        CreateShader(border_vert, border_vert_len, SDL_GPU_SHADERSTAGE_VERTEX, 0, 1);
+    SDL_GPUShader* fs = CreateShader(
+        border_frag, border_frag_len, SDL_GPU_SHADERSTAGE_FRAGMENT, 1, 1);
+    if (vs && fs) {
+        const SDL_GPUColorTargetDescription target = {
+            .format = border_test_format ? SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM
+                                         : SDL_GetGPUSwapchainTextureFormat(device, sdl3_window),
+        };
+        const SDL_GPUGraphicsPipelineCreateInfo info = {
+            .vertex_shader = vs,
+            .fragment_shader = fs,
+            .primitive_type = SDL_GPU_PRIMITIVETYPE_TRIANGLESTRIP,
+            .target_info =
+                {
+                    .color_target_descriptions = &target,
+                    .num_color_targets = 1,
+                },
+        };
+        pipe_border = SDL_CreateGPUGraphicsPipeline(device, &info);
+        if (!pipe_border) {
+            ERRORF("soft borders: SDL_CreateGPUGraphicsPipeline: %s", SDL_GetError());
+        }
+    }
+    if (vs) {
+        SDL_ReleaseGPUShader(device, vs);
+    }
+    if (fs) {
+        SDL_ReleaseGPUShader(device, fs);
+    }
+    const SDL_GPUSamplerCreateInfo sampler_info = {
+        .min_filter = SDL_GPU_FILTER_LINEAR,
+        .mag_filter = SDL_GPU_FILTER_LINEAR,
+        .mipmap_mode = SDL_GPU_SAMPLERMIPMAPMODE_NEAREST,
+        .address_mode_u = SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE,
+        .address_mode_v = SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE,
+        .address_mode_w = SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE,
+    };
+    border_sampler = pipe_border ? SDL_CreateGPUSampler(device, &sampler_info) : NULL;
+    if (!pipe_border || !border_sampler) {
+        return false;
+    }
+    border_failed = false;
+    return true;
+}
+
+// The picture shrunk for the soft borders: halved again and again (each
+// step averages 2 x 2 pixels, with linear filtering) until it is at most 48
+// pixels tall, so the border blur works on a smooth small copy. Sampling the
+// full-size picture sparsely gave a visible grid of sharp copies.
+#define BORDER_LEVELS 8
+static SDL_GPUTexture* border_level[BORDER_LEVELS];
+static Uint32 border_level_w[BORDER_LEVELS], border_level_h[BORDER_LEVELS];
+
+static SDL_GPUTexture* BorderLevel(int i, Uint32 w, Uint32 h) {
+    if (border_level[i] && border_level_w[i] >= w && border_level_h[i] >= h) {
+        return border_level[i];
+    }
+    if (border_level[i]) {
+        SDL_ReleaseGPUTexture(device, border_level[i]);
+        border_level[i] = NULL;
+    }
+    // a little room to grow, so a slightly bigger picture needs no new one
+    w += w / 4 + 8;
+    h += h / 4 + 8;
+    const SDL_GPUTextureCreateInfo info = {
+        .type = SDL_GPU_TEXTURETYPE_2D,
+        .format = SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM,
+        .usage = SDL_GPU_TEXTUREUSAGE_COLOR_TARGET | SDL_GPU_TEXTUREUSAGE_SAMPLER,
+        .width = w,
+        .height = h,
+        .layer_count_or_depth = 1,
+        .num_levels = 1,
+    };
+    border_level[i] = SDL_CreateGPUTexture(device, &info);
+    border_level_w[i] = border_level[i] ? w : 0;
+    border_level_h[i] = border_level[i] ? h : 0;
+    return border_level[i];
+}
+
+// Shrinks the area (x, y, w, h) of tex; returns the small copy and its
+// content size (*cw x *ch) and allocated size (*aw x *ah), or tex itself
+// when it is already small.
+static SDL_GPUTexture* ShrinkForBorders(SDL_GPUCommandBuffer* cmd, SDL_GPUTexture* tex,
+                                        float x, float y, float w, float h, float* cw,
+                                        float* ch, float* aw, float* ah) {
+    SDL_GPUTexture* from = tex;
+    Uint32 fx = (Uint32)(x + 0.5f), fy = (Uint32)(y + 0.5f);
+    Uint32 fw = (Uint32)(w + 0.5f), fh = (Uint32)(h + 0.5f);
+    *cw = w;
+    *ch = h;
+    for (int i = 0; i < BORDER_LEVELS && fh > 48 && fw > 2; i++) {
+        Uint32 nw = (fw + 1) / 2, nh = (fh + 1) / 2;
+        SDL_GPUTexture* to = BorderLevel(i, nw, nh);
+        if (!to) {
+            break;
+        }
+        const SDL_GPUBlitInfo blit = {
+            .source = {.texture = from, .x = fx, .y = fy, .w = fw, .h = fh},
+            .destination = {.texture = to, .x = 0, .y = 0, .w = nw, .h = nh},
+            .load_op = SDL_GPU_LOADOP_DONT_CARE,
+            .filter = SDL_GPU_FILTER_LINEAR,
+        };
+        SDL_BlitGPUTexture(cmd, &blit);
+        from = to;
+        fx = fy = 0;
+        fw = nw;
+        fh = nh;
+        *cw = (float)nw;
+        *ch = (float)nh;
+        *aw = (float)border_level_w[i];
+        *ah = (float)border_level_h[i];
+    }
+    return from;
+}
+
+static void DrawBorderBars(SDL_GPUCommandBuffer* cmd, SDL_GPUTexture* swapchain, Uint32 sc_w,
+                           Uint32 sc_h, SDL_GPUTexture* tex, float tw, float th,
+                           const BorderBar* bars, int n_bars) {
+    if (n_bars <= 0 || !EnsureBorderPipeline()) {
+        return;
+    }
+    const SDL_GPUColorTargetInfo target = {
+        .texture = swapchain,
+        .load_op = SDL_GPU_LOADOP_LOAD,
+        .store_op = SDL_GPU_STOREOP_STORE,
+    };
+    SDL_GPURenderPass* pass = SDL_BeginGPURenderPass(cmd, &target, 1, NULL);
+    if (!pass) {
+        return;
+    }
+    SDL_BindGPUGraphicsPipeline(pass, pipe_border);
+    const SDL_GPUTextureSamplerBinding binding = {.texture = tex, .sampler = border_sampler};
+    SDL_BindGPUFragmentSamplers(pass, 0, &binding, 1);
+    for (int i = 0; i < n_bars; i++) {
+        const BorderBar* b = &bars[i];
+        if (b->x1 - b->x0 < 1.0f || b->y1 - b->y0 < 1.0f) {
+            continue;
+        }
+        const float rect[4] = {
+            b->x0 / (float)sc_w * 2.0f - 1.0f, 1.0f - b->y0 / (float)sc_h * 2.0f,
+            b->x1 / (float)sc_w * 2.0f - 1.0f, 1.0f - b->y1 / (float)sc_h * 2.0f};
+        // 9 x 9 taps 1.5 pixels apart on the shrunk picture (ShrinkForBorders,
+        // about 48 pixels tall): with the shrinking, a smooth blur over about
+        // a fifth of the picture's height
+        float step = 1.5f;
+        const float frag[12] = {
+            b->u_at_x0 / tw, b->u_at_x1 / tw, b->v0 / th, b->v1 / th,
+            b->au0 / tw, b->av0 / th, b->au1 / tw, b->av1 / th,
+            step / tw, step / th, b->bright_x0, b->bright_x1};
+        SDL_PushGPUVertexUniformData(cmd, 0, rect, sizeof(rect));
+        SDL_PushGPUFragmentUniformData(cmd, 0, frag, sizeof(frag));
+        SDL_DrawGPUPrimitives(pass, 4, 1, 0, 0);
+    }
+    SDL_EndGPURenderPass(pass);
+}
