+#version 450
+
+// Soft borders: the picture's own edge, mirrored into the bar, blurred and
+// darkened, instead of black. Nothing new is drawn; it is an echo of the
+// edge of the picture next to it.
+layout(location = 0) in vec2 ts;
+layout(location = 0) out vec4 FragColor;
+
+layout(set = 2, binding = 0) uniform sampler2D src;
+// map: texture u at ts.x = 0 and 1, v at ts.y = 0 and 1 (the mirrored edge)
+// area: the picture in the texture {u0, v0, u1, v1}; samples stay inside it
+// look: blur step in u and v, brightness at ts.x = 0 and at ts.x = 1
+layout(set = 3, binding = 0) uniform UBO { vec4 map; vec4 area; vec4 look; };
+
+void main() {
+    vec2 uv = vec2(mix(map.x, map.y, ts.x), mix(map.z, map.w, ts.y));
+    vec3 sum = vec3(0.0);
+    float wsum = 0.0;
+    for (int j = -4; j <= 4; j++) {
+        for (int i = -4; i <= 4; i++) {
+            float w = exp(-float(i * i + j * j) / 10.0);
+            vec2 p = clamp(uv + vec2(float(i), float(j)) * look.xy, area.xy, area.zw);
+            sum += texture(src, p).rgb * w;
+            wsum += w;
+        }
+    }
+    float bright = mix(look.z, look.w, ts.x);
+    FragColor = vec4(sum / wsum * bright, 1.0);
+}
diff --git a/psyz/src/platform/shaders/border.vert.glsl b/psyz/src/platform/shaders/border.vert.glsl
new file mode 100644
index 0000000..2db87df
--- /dev/null
+++ b/psyz/src/platform/shaders/border.vert.glsl
@@ -0,0 +1,15 @@
+#version 450
+
+// Soft borders (Psyz_VideoSetSoftBorders): one bar beside the picture, drawn
+// as a quad from the vertex index (no vertex buffer). rect is the bar in
+// normalised device coordinates {left, top, right, bottom}; ts runs 0..1
+// across it, top-left to bottom-right.
+layout(set = 1, binding = 0) uniform UBO { vec4 rect; };
+
+layout(location = 0) out vec2 ts;
+
+void main() {
+    vec2 c = vec2(float(gl_VertexIndex & 1), float((gl_VertexIndex >> 1) & 1));
+    ts = c;
+    gl_Position = vec4(mix(rect.xy, rect.zw, c), 0.0, 1.0);
+}
