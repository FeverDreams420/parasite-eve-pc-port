+// ---- precise geometry (Psyz_VideoSetPrecision) ----------------------------
+// Exact screen positions of projected vertices, keyed by the packed integer
+// screen XY. Entries of the last two frames count; a key seen again simply
+// takes the newest position (vertices that round to the same pixel are less
+// than a pixel apart anyway).
+#define PGXP_SIZE 8192
+#define PGXP_PROBE 4
+static int pgxp_on;
+static unsigned pgxp_gen = 2;
+static struct {
+    unsigned key, gen;
+    float x, y;
+} pgxp[PGXP_SIZE];
+
+static inline unsigned pgxp_hash(unsigned k) {
+    k ^= k >> 15;
+    k *= 0x2C1B3C6Du;
+    k ^= k >> 12;
+    return k & (PGXP_SIZE - 1);
+}
+
+void Psyz_VideoSetPrecision(int on) { pgxp_on = on != 0; }
+int Psyz_PgxpEnabled(void) { return pgxp_on; }
+void Psyz_PgxpNewFrame(void) { pgxp_gen++; }
+
+static void pgxp_record(int sx, int sy, double x, double y) {
+    unsigned key = SXY(sx, sy), h = pgxp_hash(key), i, slot = h;
+    for (i = 0; i < PGXP_PROBE; i++) {
+        unsigned j = (h + i) & (PGXP_SIZE - 1);
+        if (pgxp[j].key == key || pgxp[j].gen + 1 < pgxp_gen) {
+            slot = j;
+            break;
+        }
+    }
+    pgxp[slot].key = key;
+    pgxp[slot].gen = pgxp_gen;
+    pgxp[slot].x = (float)x;
+    pgxp[slot].y = (float)y;
+}
+
+int Psyz_PgxpLookup(unsigned int sxy, float* x, float* y) {
+    unsigned h = pgxp_hash(sxy), i;
+    if (!pgxp_on) {
+        return 0;
+    }
+    for (i = 0; i < PGXP_PROBE; i++) {
+        unsigned j = (h + i) & (PGXP_SIZE - 1);
+        if (pgxp[j].key == sxy && pgxp[j].gen + 1 >= pgxp_gen) {
+            *x = pgxp[j].x;
+            *y = pgxp[j].y;
+            return 1;
+        }
+    }
+    return 0;
+}
