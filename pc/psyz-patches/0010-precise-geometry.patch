diff --git a/psyz/include/psyz/video.h b/psyz/include/psyz/video.h
index d9e9762..63ee212 100644
--- a/psyz/include/psyz/video.h
+++ b/psyz/include/psyz/video.h
@@ -298,6 +298,19 @@ int Psyz_VideoHiresIndices4Active(int slot);
  * that extra picture itself (wider culling). 24-bit (movie) display stays
  * 4:3. Best above 1x internal resolution: at 1x the squeeze drops columns.
  */
+/**
+ * @brief Precise geometry: draw polygons at the exact projected positions
+ *
+ * The GTE rounds each projected vertex to a whole screen pixel, which makes
+ * models wobble and turns tiny triangles the wrong way. While on, it also
+ * keeps the exact position of every vertex it projects (RTPS/RTPT), keyed by
+ * the rounded screen XY the game copies into its primitives; polygons whose
+ * vertices are found there are drawn at the exact positions, and NCLIP uses
+ * them for its facing test. Vertices the game made or moved itself keep
+ * their whole pixels. Meant for internal resolutions above 1x.
+ */
+void Psyz_VideoSetPrecision(int on);
+
 void Psyz_VideoSetWidescreen(int on);
 int Psyz_VideoGetWidescreen(void);
 
