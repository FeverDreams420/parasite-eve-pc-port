 #define VRAM_H 512
 
+// Precise geometry (Psyz_VideoSetPrecision, libgte.c): while on, the GTE
+// keeps each projected vertex's exact screen position, looked up later by its
+// integer screen XY (the value the game puts in its primitives).
+int Psyz_PgxpEnabled(void);
+int Psyz_PgxpLookup(unsigned int sxy, float* x, float* y);
+void Psyz_PgxpNewFrame(void);
+
 // SDL platform lifecycle code uses this to avoid undoing an explicit game
 // audio pause when the application returns from the background.
 int Psyz_AudioIsPaused(void);
