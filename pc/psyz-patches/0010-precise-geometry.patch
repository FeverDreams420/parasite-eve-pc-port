+// The exact projection of the vertex just transformed (sf = 1): view space
+// from the full products, divided in floating point. Kept only when it
+// rounds down to the GTE's own result, so saturated or clipped vertices and
+// odd cases keep their integer position.
+#define PGXP_VERTEX(sf, x, y, z, sx, sy)                                       \
+    do {                                                                       \
+        if (pgxp_on && (sf)) {                                                 \
+            double pv_z = ((double)M.t[2] * 4096.0 + (double)M.m[2][0] * (x) + \
+                           (double)M.m[2][1] * (y) + (double)M.m[2][2] * (z)) / \
+                          4096.0;                                              \
+            if (pv_z >= 1.0) {                                                 \
+                double pv_x = ((double)M.t[0] * 4096.0 +                       \
+                               (double)M.m[0][0] * (x) +                       \
+                               (double)M.m[0][1] * (y) +                       \
+                               (double)M.m[0][2] * (z)) / 4096.0;              \
+                double pv_y = ((double)M.t[1] * 4096.0 +                       \
+                               (double)M.m[1][0] * (x) +                       \
+                               (double)M.m[1][1] * (y) +                       \
+                               (double)M.m[1][2] * (z)) / 4096.0;              \
+                double pv_sx = OFX + (double)H * pv_x / pv_z;                  \
+                double pv_sy = OFY + (double)H * pv_y / pv_z;                  \
+                if (pv_sx > (sx) - 1.0 && pv_sx < (sx) + 2.0 &&                \
+                    pv_sy > (sy) - 1.0 && pv_sy < (sy) + 2.0) {                \
+                    pgxp_record((sx), (sy), pv_sx, pv_sy);                     \
+                }                                                              \
+            }                                                                  \
+        }                                                                      \
+    } while (0)
