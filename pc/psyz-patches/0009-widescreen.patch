+/**
+ * @brief Widescreen: show a 4:3 game at 16:9 with more of its picture
+ *
+ * While on, everything drawn inside the display buffer is squeezed to 3/4 of
+ * its width around the buffer's centre, so what the game draws from -1/6 to
+ * 7/6 of its width is kept, and a 16:9 window of that, as tall as the lines
+ * the game shows, fills the screen (see Psyz_VideoSetWidescreenShift).
+ * Things inside the game's normal screen keep their shape. The game has to draw
+ * that extra picture itself (wider culling). 24-bit (movie) display stays
+ * 4:3. Best above 1x internal resolution: at 1x the squeeze drops columns.
+ */
+void Psyz_VideoSetWidescreen(int on);
+int Psyz_VideoGetWidescreen(void);
+
+/**
+ * @brief Slide the widescreen window for what is drawn into the current
+ * drawing area (one value per display buffer), in game pixels: the window's
+ * centre minus the screen's. A port uses it to keep the window on the
+ * picture it actually drew near the end of a scrolling background.
+ * Psyz_VideoResetWidescreenShift sets both buffers back to the centre.
+ */
+void Psyz_VideoSetWidescreenShift(float shift);
+void Psyz_VideoResetWidescreenShift(void);
+/** @return half the widescreen window's width, in game pixels; the shift is
+ * kept within this minus half the screen width so the game's screen stays in */
+float Psyz_VideoGetWidescreenHalfView(void);
