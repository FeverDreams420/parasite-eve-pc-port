+// Half the widescreen window's width in game pixels: 16:9 of the lines the
+// game shows, for its pixel aspect.
+static float WsHalfView(float game_aspect) {
+    int top, lines;
+    VisibleRows(&top, &lines);
+    if (display_size.x <= 0 || display_size.y <= 0 || game_aspect <= 0.0f) {
+        return (float)display_size.x * 0.5f;
+    }
+    float par = game_aspect * (float)display_size.y / (float)display_size.x;
+    return (float)lines * (16.0f / 9.0f) / par * 0.5f;
+}
+
+float Psyz_VideoGetWidescreenHalfView(void) {
+    return WsHalfView(GetCurrentGameAspectRatio(display_size.x, display_size.y));
+}
+
+void Psyz_VideoSetWidescreenShift(float shift) {
+    int i, slot = -1;
+    if (!widescreen) {
+        shift = 0.0f;
+    }
+    for (i = 0; i < 2 && slot < 0; i++) {
+        if (ws_shift[i].y == draw_area_start.y) {
+            slot = i;
+        }
+    }
+    for (i = 0; i < 2 && slot < 0; i++) {
+        if (ws_shift[i].y < 0) {
+            slot = i;
+        }
+    }
+    if (slot < 0) {
+        slot = 0;
+        ws_shift[1].y = -1;
+    }
+    ws_shift[slot].y = draw_area_start.y;
+    ws_shift[slot].shift = shift;
+}
+
+void Psyz_VideoResetWidescreenShift(void) {
+    ws_shift[0].shift = ws_shift[1].shift = 0.0f;
+}
+
+void Psyz_VideoSetWidescreen(int on) {
+    if ((on != 0) != widescreen) {
+        Draw_FlushBuffer();
+        widescreen = on != 0;
+    }
+}
+
+int Psyz_VideoGetWidescreen(void) { return widescreen ? 1 : 0; }
