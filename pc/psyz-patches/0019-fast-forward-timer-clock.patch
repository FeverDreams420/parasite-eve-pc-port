+// The timers' clock (Psyz_KernelSetVBlankClock): normally the host's
+// microseconds (plus an offset kept across switches); while a port runs the
+// game faster than real time it can switch to one blank's worth of time per
+// Psyz_KernelVBlank, so timer-driven code (a sound driver) keeps pace with
+// the game instead of falling behind it.
+static AtomicWord clock_vblank;
+static AtomicTime clock_offset_us, clock_vblank_us;
+static unsigned clock_frac;
+// timer ticks fired and blanks so far (debug and the port's sound watchdog)
+static unsigned timer_ticks[3], vblank_count;
+unsigned Psyz_KernelTimerTicks(int i) { return i >= 0 && i < 3 ? timer_ticks[i] : 0; }
+unsigned Psyz_KernelVBlankCount(void) { return vblank_count; }
+static uint64_t KernelNowUs(void) {
+    if (AtomicLoad(&clock_vblank)) {
+        return AtomicTimeLoad(&clock_vblank_us);
+    }
+    return Psyz_OsNowUs() + AtomicTimeLoad(&clock_offset_us);
+}
+
 static PendingEvent pending[32];
 static int pending_len;
 
@@ -294,10 +313,33 @@ void Psyz_KernelPost(void (*fn)(void)) {
 }
 
 void Psyz_KernelVBlank(void) {
+    vblank_count++;
+    if (AtomicLoad(&clock_vblank)) {
+        // one NTSC blank: 1001000 / 60 us = 16683 1/3
+        clock_frac += 1;
+        uint64_t add = 16683 + (clock_frac % 3 == 0 ? 1 : 0);
+        AtomicTimeStore(&clock_vblank_us, AtomicTimeLoad(&clock_vblank_us) + add);
+    }
     Psyz_KernelPoll();
     LatchLine(IRQ_VBLANK);
 }
 
+void Psyz_KernelSetVBlankClock(int on) {
+    uint64_t now = KernelNowUs();
+    on = on != 0;
+    if (on == (int)AtomicLoad(&clock_vblank)) {
+        return;
+    }
+    if (on) {
+        AtomicTimeStore(&clock_vblank_us, now);
+        AtomicStore(&clock_vblank, 1);
+    } else {
+        // carry on from where blank time got to: never back in time
+        AtomicTimeStore(&clock_offset_us, now - Psyz_OsNowUs());
+        AtomicStore(&clock_vblank, 0);
+    }
+}
