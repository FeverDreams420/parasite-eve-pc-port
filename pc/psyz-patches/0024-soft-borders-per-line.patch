+// A CPU copy of the native VRAM, kept from every upload, fill and copy (not
+// from drawing), so the host can see which texels of a texture are empty
+// (Psyz_VramShadow). Only the 1x VRAM; HD sampling is unaffected.
+static u16 vram_shadow[VRAM_H][VRAM_W];
+
+const unsigned short* Psyz_VramShadow(void) { return &vram_shadow[0][0]; }
+
+static void ShadowFill(int x, int y, int w, int h, u16 c) {
+    for (int j = y < 0 ? 0 : y; j < y + h && j < VRAM_H; j++) {
+        for (int i = x < 0 ? 0 : x; i < x + w && i < VRAM_W; i++) {
+            vram_shadow[j][i] = c;
+        }
+    }
+}
