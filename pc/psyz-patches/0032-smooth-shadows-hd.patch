@@ -84,6 +84,31 @@ uint rgb5551ToU16(vec4 c) {
     return r | (g << 5u) | (b << 10u) | (a << 15u);
 }
 
+// One indexed texel through its CLUT, at the same limits as resolveTexel.
+vec4 indexedTexel(ivec2 t) {
+    uvec2 texel = uvec2(clamp(t, ivec2(0), ivec2(255)));
+    texel = clamp(texel, uvLimits.xy, uvLimits.zw);
+    texel = (texel & texWindow.xy) | texWindow.zw;
+    uint subPixel = texel.x & subPixelMask;
+    ivec2 texelPos = ivec2(int(texel.x >> texelShift), int(texel.y));
+    uint word16 = rgb5551ToU16(texelFetch(texVram, pageBase + texelPos, 0));
+    uint colorIdx = (word16 >> (subPixel * indexShift)) & indexMask;
+    ivec2 clutBase = ivec2((clut % 64u) * 16u, clut / 64u);
+    return texelFetch(texVram, clutBase + ivec2(colorIdx, 0), 0);
+}
+
+// Smooth shadows (TPAGE_SMOOTH): the four nearest texels mixed by distance.
+// A transparent texel is (0, 0, 0, 0), black, which a subtractive blend
+// leaves unchanged; the result is transparent only where all four are.
+vec4 smoothTexel(vec2 uvShift) {
+    vec2 uv = rawUV - uvShift + 1.0 / 512.0 - 0.5;
+    ivec2 t = ivec2(floor(uv));
+    vec2 f = uv - vec2(t);
+    vec4 a = mix(indexedTexel(t), indexedTexel(t + ivec2(1, 0)), f.x);
+    vec4 b = mix(indexedTexel(t + ivec2(0, 1)), indexedTexel(t + ivec2(1, 1)), f.x);
+    return mix(a, b, f.y);
+}
