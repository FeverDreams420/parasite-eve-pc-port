+// A write to VRAM that overlaps a sharper 4-bit area turns it off: its
+// indices no longer match what the game put there.
+static void HiresTouch(int x, int y, int w, int h) {
+    if (w <= 0 || h <= 0) {
+        return;
+    }
+    for (int i = 0; i < PSYZ_HIRES_SLOTS; i++) {
+        if (hires[i].on && x < hires[i].x + hires[i].w &&
+            x + w > hires[i].x && y < hires[i].y + hires[i].h &&
+            y + h > hires[i].y) {
+            Draw_FlushBuffer(); // what was queued still sees the old indices
+            hires[i].on = false;
+        }
+    }
+}
+
+// Upload rows of `indices` (the whole area, tex_w wide) under the sub-rect
+// ox, oy, pw x ph (in index pixels) of slot's texture.
+static int HiresUpload(int slot, unsigned ox, unsigned oy, unsigned pw,
+                       unsigned ph, const unsigned char* indices) {
+    const SDL_GPUTransferBufferCreateInfo tinfo = {
+        .usage = SDL_GPU_TRANSFERBUFFERUSAGE_UPLOAD,
+        .size = pw * ph,
+    };
+    SDL_GPUTransferBuffer* tb = SDL_CreateGPUTransferBuffer(device, &tinfo);
+    SDL_GPUCommandBuffer* cmd = tb ? AcquireCmd() : NULL;
+    u8* map = cmd ? SDL_MapGPUTransferBuffer(device, tb, false) : NULL;
+    if (!map) {
+        if (tb) {
+            SDL_ReleaseGPUTransferBuffer(device, tb);
+        }
+        return -1;
+    }
+    for (unsigned row = 0; row < ph; row++) {
+        memcpy(map + (size_t)row * pw,
+               indices + (size_t)(oy + row) * hires[slot].tex_w + ox, pw);
+    }
+    SDL_UnmapGPUTransferBuffer(device, tb);
+    SDL_GPUCopyPass* copy = SDL_BeginGPUCopyPass(cmd);
+    const SDL_GPUTextureTransferInfo src = {
+        .transfer_buffer = tb, .pixels_per_row = pw, .rows_per_layer = ph};
+    const SDL_GPUTextureRegion dst = {.texture = hires[slot].tex,
+                                      .x = ox,
+                                      .y = oy,
+                                      .w = pw,
+                                      .h = ph,
+                                      .d = 1};
+    SDL_UploadToGPUTexture(copy, &src, &dst, false);
+    SDL_EndGPUCopyPass(copy);
+    SDL_ReleaseGPUTransferBuffer(device, tb);
+    return 0;
+}
+
+int Psyz_VideoSetHiresIndices4(int slot, int x, int y, int w, int h,
+                               unsigned scale, const unsigned char* indices) {
+    if (slot < 0 || slot >= PSYZ_HIRES_SLOTS) {
+        return -1;
+    }
+    if (!indices) {
+        if (hires[slot].on) {
+            Draw_FlushBuffer();
+        }
+        hires[slot].on = false;
+        return 0;
+    }
+    if (scale < 2 || scale > PSYZ_INTERNAL_RES_MAX || w <= 0 || h <= 0 ||
+        x < 0 || y < 0 || x + w > VRAM_W || y + h > VRAM_H || !device) {
+        return -1;
+    }
+    Draw_FlushBuffer();
+    const unsigned tw = (unsigned)w * 4 * scale, th = (unsigned)h * scale;
+    if (!hires[slot].tex || hires[slot].tex_w != tw ||
+        hires[slot].tex_h != th) {
+        if (hires[slot].tex) {
+            SDL_ReleaseGPUTexture(device, hires[slot].tex);
+        }
+        const SDL_GPUTextureCreateInfo info = {
+            .type = SDL_GPU_TEXTURETYPE_2D,
+            .format = SDL_GPU_TEXTUREFORMAT_R8_UNORM,
+            .usage = SDL_GPU_TEXTUREUSAGE_SAMPLER,
+            .width = tw,
+            .height = th,
+            .layer_count_or_depth = 1,
+            .num_levels = 1,
+        };
+        hires[slot].tex = SDL_CreateGPUTexture(device, &info);
+        if (!hires[slot].tex) {
+            ERRORF("SDL_CreateGPUTexture: %s", SDL_GetError());
+            hires[slot].on = false;
+            return -1;
+        }
+        hires[slot].tex_w = tw;
+        hires[slot].tex_h = th;
+    }
+    if (HiresUpload(slot, 0, 0, tw, th, indices) != 0) {
+        hires[slot].on = false;
+        return -1;
+    }
+    hires[slot].x = x;
+    hires[slot].y = y;
+    hires[slot].w = w;
+    hires[slot].h = h;
+    hires[slot].scale = scale;
+    hires[slot].on = true;
+    return 0;
+}
+
+int Psyz_VideoUpdateHiresIndices4(
+    int slot, int x, int y, int w, int h, const unsigned char* indices) {
+    if (slot < 0 || slot >= PSYZ_HIRES_SLOTS || !hires[slot].tex ||
+        !indices || !device || w <= 0 || h <= 0 || x < hires[slot].x ||
+        y < hires[slot].y || x + w > hires[slot].x + hires[slot].w ||
+        y + h > hires[slot].y + hires[slot].h) {
+        return -1;
+    }
+    Draw_FlushBuffer();
+    const unsigned s = hires[slot].scale;
+    if (HiresUpload(slot, (unsigned)(x - hires[slot].x) * 4 * s,
+                    (unsigned)(y - hires[slot].y) * s, (unsigned)w * 4 * s,
+                    (unsigned)h * s, indices) != 0) {
+        return -1;
+    }
+    hires[slot].on = true;
+    return 0;
+}
+
+int Psyz_VideoHiresIndices4Active(int slot) {
+    return slot >= 0 && slot < PSYZ_HIRES_SLOTS && hires[slot].on ? 1 : 0;
+}
