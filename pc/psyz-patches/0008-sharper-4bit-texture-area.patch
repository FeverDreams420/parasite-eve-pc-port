+bool hiresPos(int i, ivec2 texel, vec2 texelStep, out ivec2 pos) {
+    int s = hiresParam[i].x;
+    pos = ivec2(0);
+    if (hiresParam[i].y == 0 || s <= 1) {
+        return false;
+    }
+    ivec4 a = hiresArea[i];
+    ivec2 vram = pageBase + ivec2(texel.x >> 2, texel.y);
+    if (vram.x < a.x || vram.y < a.y || vram.x >= a.x + a.z ||
+        vram.y >= a.y + a.w) {
+        return false;
+    }
+    vec2 uv = (rawUV - 0.5 * texelStep + 1.0 / 512.0) * float(s);
+    ivec2 h = clamp(ivec2(floor(uv)), texel * s, texel * s + (s - 1));
+    pos = ivec2((pageBase.x - a.x) * 4, pageBase.y - a.y) * s + h;
+    return true;
+}
