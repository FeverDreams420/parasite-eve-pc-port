+/**
+ * @brief Sharper 4-bit texture area at higher internal resolutions
+ *
+ * Hands over the colour indices of a 4-bit texture area redrawn at `scale`
+ * times its size: one byte per index, (w * 4 * scale) wide and (h * scale)
+ * tall, row by row. While the internal resolution is above 1x, 4-bit
+ * polygons and sprites that sample inside the area read these indices
+ * instead of the 1x ones, refined inside the texel the 1x path picks; the
+ * palette lookup, transparency and blending are unchanged, so the colours
+ * stay the game's own.
+ *
+ * Any other write to the area (image upload, clear, copy, drawing) turns it
+ * off until the next call. Up to PSYZ_HIRES_SLOTS areas, one per slot, which
+ * should not overlap; NULL turns a slot off.
+ *
+ * @param slot 0 to PSYZ_HIRES_SLOTS - 1
+ * @param x, y, w, h Area in VRAM pixels (16-bit units)
+ * @param scale Size factor of the indices, 2 to PSYZ_INTERNAL_RES_MAX
+ * @param indices Redrawn indices, or NULL
+ * @return 0 on success, -1 on invalid arguments or no GPU
+ */
+int Psyz_VideoSetHiresIndices4(int slot, int x, int y, int w, int h,
+                               unsigned scale, const unsigned char* indices);
+
+/**
+ * @brief Re-send part of a sharper 4-bit area and turn it back on
+ *
+ * For a port that saw its own write to the area (which turned it off) and
+ * redrew that part: `indices` is the whole area in the layout given to
+ * Psyz_VideoSetHiresIndices4, and only the part under x, y, w, h (VRAM
+ * pixels, inside the area) is sent.
+ *
+ * @return 0 on success, -1 when the slot has no area or the part is outside it
+ */
+int Psyz_VideoUpdateHiresIndices4(
+    int slot, int x, int y, int w, int h, const unsigned char* indices);
+
+/** @return 1 while the slot's area is set and not turned off */
+int Psyz_VideoHiresIndices4Active(int slot);
