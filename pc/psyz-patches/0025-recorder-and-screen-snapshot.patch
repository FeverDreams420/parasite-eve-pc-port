+int Psyz_VideoRecordStart(const char* path, int w, int h) {
+    if (rec.f || w <= 0 || h <= 0) {
+        return 0;
+    }
+    rec.f = fopen(path, "wb");
+    if (!rec.f) {
+        return 0;
+    }
+    if (rec.tex && (rec.w != w || rec.h != h)) {
+        if (rec.rgba != rec.tex) {
+            SDL_ReleaseGPUTexture(device, rec.rgba);
+        }
+        SDL_ReleaseGPUTexture(device, rec.tex);
+        for (int i = 0; i < REC_SLOTS; i++) {
+            SDL_ReleaseGPUTransferBuffer(device, rec.slot[i].tb);
+            rec.slot[i].tb = NULL;
+        }
+        rec.tex = rec.rgba = NULL;
+    }
+    rec.w = w;
+    rec.h = h;
+    rec.row = realloc(rec.row, (size_t)w * h * 3);
+    rec.present = 0;
+    rec.t0 = SDL_GetPerformanceCounter();
+    return 1;
+}
+
+void Psyz_VideoRecordTag(unsigned frame) { rec.tag = frame; }
+
+void Psyz_VideoRecordStop(void) {
+    if (!rec.f) {
+        return;
+    }
+    SubmitFrame(); // anything still in the current command buffer
+    for (int k = 0; k < REC_SLOTS; k++) {
+        RecFlushSlot((rec.next + k) % REC_SLOTS, true);
+    }
+    fclose(rec.f);
+    rec.f = NULL;
+}
